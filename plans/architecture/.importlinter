[importlinter]
root_package = reconcile

[importlinter:contract:layers]
name = Enforce layered architecture
type = layers
layers =
    presentation
    application
    domain
    infrastructure

[importlinter:contract:independence]
name = Domain layer independence
type = forbidden
source_modules =
    reconcile.domain
forbidden_modules =
    reconcile.presentation
    reconcile.application
    reconcile.infrastructure

[importlinter:contract:no-cycles]
name = Prevent circular dependencies
type = independence
modules =
    reconcile
