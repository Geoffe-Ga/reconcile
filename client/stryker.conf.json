{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/test-setup.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": 80 }
}
