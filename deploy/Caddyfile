# deploy/Caddyfile - The one VM's web server: the app and the relay on one origin.
#
# TLS ends here, on our own VM, so no platform proxy sees members' addresses
# (ADR-0041). Nothing is logged: no access log, and the default logger, which
# would still write handler errors (a 502, say) and TLS handshake errors with
# the client's IP, discards everything. deploy/no-ip-check.sh proves it.
#
# deploy/deploy.sh installs this at /etc/caddy/Caddyfile and sets
# RECONCILE_SITE (the domain) in a caddy.service drop-in. `admin off` turns off
# `caddy reload`, so a config change needs `systemctl restart caddy`.
{
	admin off
	skip_install_trust
	log default {
		output discard
	}
}

# Every response's headers, Caddy's own error responses included.
(security_headers) {
	header {
		-Server
		# The main defense against injected script stealing keys, together
		# with #70's Markdown sanitizer. client/vite.config.ts serves the same
		# header under `vite preview`; deploy/check.sh keeps the two equal.
		Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		# HSTS: for a year after each visit, a browser uses only HTTPS here,
		# so no later request goes out in plaintext to be downgraded. No
		# includeSubDomains and no preload: deploy/README.md says why, and
		# deploy/check.sh keeps exactly this value.
		Strict-Transport-Security "max-age=31536000"
	}
}

{$RECONCILE_SITE} {
	import security_headers

	# The relay (reconcile.relay), bound to loopback. It drops client
	# addresses and forwarding headers itself; these lines mean Caddy never
	# hands it any in the first place.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -Forwarded
		}
	}

	# The built client (client/dist). Unknown paths get index.html. The
	# service worker (/sw.js) keeps it offline and never caches /v1 (#76).
	handle {
		root * /srv/reconcile/app
		# The web app manifest (#76): Go's MIME table doesn't always know
		# .webmanifest, and a manifest should say what it is.
		header /manifest.webmanifest Content-Type application/manifest+json
		try_files {path} /index.html
		file_server
	}

	# Caddy writes some responses itself, such as a 502 while the relay is
	# down, and those skip the routes above. Send them the same headers, and
	# a fixed body that repeats nothing from the request or the relay's error.
	# deploy/check.sh and deploy/no-ip-check.sh hold this.
	handle_errors {
		import security_headers
		respond "Reconcile couldn't answer that request. Try again in a moment."
	}
}
